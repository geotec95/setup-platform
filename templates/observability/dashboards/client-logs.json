{
  "id": null,
  "uid": "client-logs",
  "title": "Logs",
  "tags": ["observability", "client-dashboard", "setup-platform"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "client",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": { "query": "label_values(up, client)", "refId": "client-values" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Linhas de log por nível (5m)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum by (level) (count_over_time({client=~\"$client\", level=~\".+\"}[5m]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Só erros",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{client=~\"$client\", level=\"error\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Todos os logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{client=~\"$client\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
