{
  "id": null,
  "uid": "client-logs",
  "title": "Logs",
  "tags": ["observability", "client-dashboard", "setup-platform"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "client",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": { "query": "label_values(up, client)", "refId": "client-values" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Linhas de log por nível (5m)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum by (level) (count_over_time({client=~\"$client\", level=~\".+\"}[5m]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Só erros",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{client=~\"$client\", level=\"error\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Todos os logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{client=~\"$client\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requisições por país (período selecionado)",
      "description": "De onde vêm as requisições externas reais, com base no IP de origem geolocalizado (base MaxMind GeoLite2). Tráfego interno de infraestrutura (health-check, scrape do agente de monitoramento) já é excluído por filtro de faixa de IP privada.",
      "type": "table",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "topk(15, sum by (geoip_country_name) (count_over_time({client=~\"$client\"} | remote_addr != \"\" | remote_addr !~ `^(10\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.|127\\.)` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "geoip_country_name": "País", "Value": "Requisições" } } }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Top IPs de origem (período selecionado)",
      "description": "IPs externos reais com mais requisições no período -- tráfego interno de infraestrutura (health-checker da AWS, o próprio agente de monitoramento) já é excluído por filtro de faixa de IP privada.",
      "type": "table",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "topk(15, sum by (remote_addr, geoip_city_name, geoip_country_name) (count_over_time({client=~\"$client\"} | remote_addr != \"\" | remote_addr !~ `^(10\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.|127\\.)` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "remote_addr": "IP", "geoip_city_name": "Cidade", "geoip_country_name": "País", "Value": "Requisições" } } }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    }
  ]
}
