# templates/env/remote-agent.env.example
# Copiado/gerado automaticamente por modules/remote-agent/install.sh — não
# editar o .env real deste módulo manualmente sem necessidade.
# INGEST_USER/INGEST_PASSWORD são os mostrados na instalação do observability
# CENTRAL (não deste servidor).

CENTRAL_INGEST_DOMAIN=ingest.seudominio.com.br
INGEST_USER=ingest
INGEST_PASSWORD=troque-por-senha-mostrada-no-install-do-observability-central
CLIENT_LABEL=nome-do-cliente-ou-servidor
