# templates/env/client-dashboard.env.example
# Modelo de referência do módulo client-dashboard. O .env "base" do módulo (copiado
# para modules/client-dashboard/.env) guarda apenas a config de acesso ao Grafana
# compartilhado. Cada CLIENTE tem seu próprio .env gerado em
# modules/client-dashboard/clients/<slug>/.env (ver new-client.sh) — nunca misture
# credenciais de clientes diferentes no mesmo arquivo.

# ---------------------------------------------------------------------------
# Grafana compartilhado (instalado pelo módulo observability — NÃO duplicar
# credenciais aqui: em produção, este bloco é lido diretamente de
# modules/observability/.env pelos scripts deste módulo).
# ---------------------------------------------------------------------------
GRAFANA_BASE_URL=https://grafana.SEUDOMINIO.com.br
GRAFANA_ADMIN_USER=admin
# Senha do admin do Grafana compartilhado. Fonte da verdade real:
# modules/observability/.env -> GRAFANA_ADMIN_PASSWORD
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Branding do cliente (preenchido por new-client.sh a partir dos argumentos
# posicionais — este bloco abaixo é apenas o TEMPLATE/exemplo por cliente)
# ---------------------------------------------------------------------------
CLIENT_NAME=Cliente Exemplo Ltda
CLIENT_DOMAIN=dashboard.clientex.com.br
CLIENT_PRIMARY_COLOR=#0EA5E9
CLIENT_LOGO_URL=https://clientex.com.br/logo.png

# Credenciais do usuário viewer dedicado, criado na Organization do cliente
# dentro do Grafana compartilhado (gerado automaticamente por new-client.sh,
# NUNCA hardcode aqui em produção)
CLIENT_GRAFANA_ORG_ID=
CLIENT_GRAFANA_VIEWER_USER=
CLIENT_GRAFANA_VIEWER_PASSWORD=
