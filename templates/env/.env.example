# Template genérico de variáveis por ferramenta.
# Cada módulo copia este padrão para modules/<slug>/.env (nunca commitado).

DOMAIN=
ACME_EMAIL=
TZ=America/Sao_Paulo

# Preenchido automaticamente por sp::proxy::ensure_traefik / sp::network::public_ip
PUBLIC_IP=

# Gerar com: sp::gen_password (core/common.sh)
ADMIN_PASSWORD=
