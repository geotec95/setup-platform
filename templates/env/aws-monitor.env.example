# templates/env/aws-monitor.env.example
# Copiado para modules/aws-monitor/.env durante a instalação (nunca commitar o .env real
# com segredos). Preferir IAM Role/Instance Profile — as variáveis de credencial abaixo
# só devem ser usadas fora da AWS (ex.: execução local/CI) e, mesmo assim, de preferência
# via AWS Secrets Manager / SSM Parameter Store (ver comentário no fim do arquivo).

# Região padrão para as chamadas AWS CLI (Cost Explorer só responde em us-east-1
# para algumas contas legadas; os scripts tratam isso internamente).
AWS_REGION=us-east-1

# Perfil AWS CLI a usar (deixe vazio para usar credenciais padrão / Instance Profile)
AWS_PROFILE=

# Destinatários do report (separados por vírgula) — usado pelo node de e-mail do n8n
REPORT_EMAIL_TO=financeiro@seudominio.com.br,seguranca@seudominio.com.br

# Webhook do Slack para o report (opcional). Crie em https://api.slack.com/apps
SLACK_WEBHOOK_URL=

# Número/instância do WhatsApp Business (via n8n + Evolution API/Twilio, opcional)
WHATSAPP_TO=

# Bucket S3 para backup de configs/reports gerados (usado por providers/aws/backup-s3.sh)
S3_BACKUP_BUCKET=

# Prefixo dentro do bucket (ex: aws-monitor/reports)
S3_BACKUP_PREFIX=aws-monitor/reports

# Quantidade de backups a reter na rotação do S3 (mais antigos são removidos)
S3_BACKUP_RETENTION=30

# Zona hospedada do Route53 (opcional, usado por providers/aws/route53.sh quando o EIP mudar)
ROUTE53_ZONE_ID=

# Subdomínio a manter apontado para o IP público da instância (opcional)
ROUTE53_RECORD_NAME=

# Threshold de orçamento (USD) para alarme de custo no CloudWatch (opcional)
BUDGET_ALARM_THRESHOLD_USD=500

# Dias parada para considerar instância EC2 "ociosa" no cost-report.sh
IDLE_STOPPED_DAYS_THRESHOLD=30

# ---------------------------------------------------------------------------
# CREDENCIAIS: NUNCA coloque AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY aqui.
# Ordem de preferência:
#   1) IAM Instance Profile anexado à instância EC2 (recomendado, sem segredo em disco)
#   2) AWS SSO / `aws configure sso`
#   3) Segredo em AWS Secrets Manager, lido em runtime:
#        aws secretsmanager get-secret-value --secret-id aws-monitor/credentials \
#          --query SecretString --output text
#   4) Parameter Store (SecureString):
#        aws ssm get-parameter --name /aws-monitor/api-key --with-decryption \
#          --query Parameter.Value --output text
# ---------------------------------------------------------------------------
